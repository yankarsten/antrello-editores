// Prisma schema for Antrello Editores.
// SQLite for local dev — swap the datasource provider/url for Postgres in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: "admin" | "editor" (SQLite has no native enums)
//
// The name is the login identifier — there are no e-mail addresses. `nameKey`
// holds the normalized form (see lib/users.ts) and carries the unique index, so
// "Marina Duarte" and "marina duarte" can never be two different accounts.
model User {
  id           String   @id @default(cuid())
  name         String
  nameKey      String   @unique
  passwordHash String
  role         String   @default("editor")
  createdAt    DateTime @default(now())

  projectsCreated  Project[]       @relation("ProjectCreatedBy")
  projectsAssigned Project[]       @relation("ProjectAssignedEditor")
  deliveryVideos   DeliveryVideo[]
  invitesCreated   Invite[]        @relation("InviteCreatedBy")
  invite           Invite?         @relation("InviteAcceptedBy")
}

// A single-use access link created by an admin. Accounts exist only through one
// of these: the invitee opens the link and picks their own password.
//
// Only the SHA-256 of the token is stored, so a copy of the database cannot be
// turned into working invite links. The admin can regenerate a link (new token)
// if the original is lost.
model Invite {
  id          String    @id @default(cuid())
  name        String
  nameKey     String    @unique
  tokenHash   String    @unique
  role        String    @default("editor")
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedById String?  @unique

  createdBy  User  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: Cascade)
}

// status: "em_edicao" | "concluido"
model Project {
  id               String   @id @default(cuid())
  title            String
  description      String?
  notes            String?
  deadline         DateTime
  status           String   @default("em_edicao")
  assignedEditorId String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignedEditor User? @relation("ProjectAssignedEditor", fields: [assignedEditorId], references: [id], onDelete: SetNull)
  createdBy      User  @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  sourceVideos   SourceVideo[]
  deliveryVideos DeliveryVideo[]
}

model SourceVideo {
  id         String   @id @default(cuid())
  projectId  String
  fileName   String
  storedName String
  size       Int      @default(0)
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DeliveryVideo {
  id           String   @id @default(cuid())
  projectId    String
  // Nullable so removing an editor's account keeps the delivered videos, which
  // belong to the project rather than to the person who uploaded them.
  uploadedById String?
  label        String   @default("Vídeo Final")
  fileName     String
  storedName   String
  size         Int      @default(0)
  uploadedAt   DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}
